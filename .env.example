# Routing. `host` uses wildcard subdomains (production, and local dev via
# sean.localhost:3000); `path` serves tenants at /s/<sub> and exists because
# Vercel preview deployments cannot have wildcard subdomains. Server-only and
# read at runtime, so one build serves both.
TENANT_MODE=host
ROOT_DOMAIN=localhost:3000

# Supabase. Without these the render route falls back to the seed in
# src/server/repos/sites.ts and the builder has no session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-tier key. Bypasses RLS by design (plan §2) — never expose it to a
# client bundle and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
